{
  "name": "f2-birthday-post",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-12",
  "vars": {
    "ALLOWED_ORIGINS": "https://platopedia.com",
    "GOOGLE_SHEET_ID": "",
    "GOOGLE_SHEET_TAB": "Wishes",
    "SUBMISSIONS_CLOSE_AT": "2026-10-20T23:59:59Z"
  },
  "durable_objects": { "bindings": [{ "name": "WISH_STORE", "class_name": "WishStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WishStore"] }],
  "observability": { "enabled": false }
}
